# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# --- Embeddings semânticos ---
# "huggingface" (padrão, local, gratuito) ou "openai" (requer OPENAI_API_KEY).
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM de geração ---
# Atualmente suportado: "openai".
LLM_PROVIDER=openai
OPENAI_API_KEY=coloque-sua-chave-aqui
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Diretórios ---
PDF_SOURCE_DIR=data/pdfs
CHROMA_DIR=chroma_db
EVAL_DATASET_PATH=data/eval/qa_dataset.json
EVAL_REPORT_PATH=data/eval/eval_report.json

# --- Coleções do ChromaDB ---
SEMANTIC_COLLECTION=semantic_index
LEXICAL_COLLECTION=lexical_index

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Índice léxico (dimensão do vetor gerado pelo HashingVectorizer) ---
LEXICAL_VECTOR_SIZE=512

# --- Recuperação ---
TOP_K_SEMANTIC=5
TOP_K_LEXICAL=5
TOP_K_FINAL=4
RRF_K=60

# --- Reranking via LLM ---
# Reordena, usando o LLM, um pool maior de candidatos (RERANK_POOL_SIZE)
# vindos da fusão RRF, antes de cortar para TOP_K_FINAL. Aumenta a
# precisão do contexto final ao custo de uma chamada extra ao LLM por
# pergunta.
RERANK_ENABLED=true
RERANK_POOL_SIZE=15

# --- Avaliação ---
EVAL_TOP_K=5
